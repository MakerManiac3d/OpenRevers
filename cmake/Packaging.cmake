# SPDX-License-Identifier: GPL-3.0-or-later
# Installers: NSIS and ZIP on Windows, TGZ elsewhere (cpack).
set(CPACK_PACKAGE_NAME "OpenRevers")
set(CPACK_PACKAGE_VENDOR "MakerManiac3d")
set(CPACK_PACKAGE_CONTACT "makermaniac3d@gmail.com")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "OpenRevers — reverse engineering of scanned meshes")
set(CPACK_PACKAGE_HOMEPAGE_URL "${PROJECT_HOMEPAGE_URL}")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "OpenRevers")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_EXECUTABLES "OpenRevers" "OpenRevers")
if(WIN32)
  set(CPACK_PACKAGE_FILE_NAME "OpenRevers-${PROJECT_VERSION}-win64")
else()
  set(CPACK_PACKAGE_FILE_NAME "OpenRevers-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
endif()

install(FILES LICENSE README.md THIRD_PARTY.md DESTINATION share/doc/openrevers)
install(DIRECTORY docs/ DESTINATION share/doc/openrevers/docs)

# The licences of the libraries built into the executables, as their terms ask.
set(_lic share/doc/openrevers/licenses)
install(FILES ${pmp_SOURCE_DIR}/LICENSE.txt DESTINATION ${_lic} RENAME PMP-LICENSE.txt)
install(FILES ${miniz_SOURCE_DIR}/LICENSE DESTINATION ${_lic} RENAME miniz-LICENSE.txt)
install(FILES ${quadriflow_SOURCE_DIR}/LICENSE.txt DESTINATION ${_lic} RENAME QuadriFlow-LICENSE.txt)
install(FILES ${quadriflow_SOURCE_DIR}/3rd/lemon-1.3.1/LICENSE DESTINATION ${_lic} RENAME LEMON-LICENSE.txt)
install(FILES ${quadriflow_SOURCE_DIR}/3rd/pcg32/pcg32/pcg32.h DESTINATION ${_lic} RENAME pcg32-NOTICE.h)
foreach(_f IN ITEMS "${eigen_SOURCE_DIR}/COPYING.MPL2" "${json_SOURCE_DIR}/LICENSE.MIT")
  if(EXISTS "${_f}")
    get_filename_component(_n "${_f}" NAME)
    get_filename_component(_d "${_f}" DIRECTORY)
    get_filename_component(_d "${_d}" NAME)
    install(FILES "${_f}" DESTINATION ${_lic} RENAME "${_d}-${_n}.txt")
  endif()
endforeach()

# The Microsoft C++ runtime beside the executables, so nothing else needs installing.
set(CMAKE_INSTALL_SYSTEM_RUNTIME_DESTINATION bin)
include(InstallRequiredSystemLibraries)

if(WIN32)
  set(CPACK_GENERATOR "NSIS;ZIP")
  set(CPACK_NSIS_DISPLAY_NAME "OpenRevers")
  set(CPACK_NSIS_PACKAGE_NAME "OpenRevers ${PROJECT_VERSION}")
  set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\\\OpenRevers.exe")
  set(CPACK_NSIS_MUI_ICON "${CMAKE_SOURCE_DIR}/packaging/openrevers.ico")
  set(CPACK_NSIS_MUI_UNIICON "${CMAKE_SOURCE_DIR}/packaging/openrevers.ico")
  set(CPACK_NSIS_URL_INFO_ABOUT "${PROJECT_HOMEPAGE_URL}")
  set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
  set(CPACK_NSIS_EXECUTABLES_DIRECTORY bin)
  set(CPACK_NSIS_MODIFY_PATH OFF)
else()
  set(CPACK_GENERATOR "TGZ")
endif()
include(CPack)
